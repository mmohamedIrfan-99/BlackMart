package com.blackmart.blackmart.controller;

import com.blackmart.blackmart.dto.ApiResponse;
import com.blackmart.blackmart.dto.CartRequest;
import com.blackmart.blackmart.model.User;
import com.blackmart.blackmart.service.CartService;
import com.google.gson.Gson;

import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import java.io.BufferedReader;
import java.io.IOException;

@WebServlet("/api/cart")
public class CartServlet extends HttpServlet {

    private final CartService cartService = new CartService();
    private final Gson gson = new Gson();

    @Override
    protected void doGet(HttpServletRequest request,
                         HttpServletResponse response)
            throws IOException {

        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");

        try {
            User buyer = getBuyer(request);

            if (buyer == null) {
                sendError(response,
                        HttpServletResponse.SC_UNAUTHORIZED,
                        "Buyer login required");
                return;
            }

            sendSuccess(
                    response,
                    "Cart loaded successfully",
                    cartService.getCart(buyer.getId())
            );

        } catch (Exception e) {
            sendError(response,
                    HttpServletResponse.SC_BAD_REQUEST,
                    getMessage(e));
        }
    }

    @Override
    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws IOException {

        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");

        try {
            User buyer = getBuyer(request);

            if (buyer == null) {
                sendError(response,
                        HttpServletResponse.SC_UNAUTHORIZED,
                        "Buyer login required");
                return;
            }

            String action = request.getParameter("action");

            if ("add".equalsIgnoreCase(action)) {
                addItem(request, response, buyer);

            } else if ("update".equalsIgnoreCase(action)) {
                updateItem(request, response, buyer);

            } else if ("remove".equalsIgnoreCase(action)) {
                removeItem(request, response, buyer);

            } else if ("clear".equalsIgnoreCase(action)) {
                cartService.clearCart(buyer.getId());

                sendSuccess(
                        response,
                        "Cart cleared successfully",
                        null
                );

            } else {
                sendError(response,
                        HttpServletResponse.SC_BAD_REQUEST,
                        "Invalid cart action");
            }

        } catch (Exception e) {
            sendError(response,
                    HttpServletResponse.SC_BAD_REQUEST,
                    getMessage(e));
        }
    }

    private void addItem(HttpServletRequest request,
                         HttpServletResponse response,
                         User buyer)
            throws IOException {

        CartRequest cartRequest = readRequest(request);

        cartService.addToCart(
                buyer.getId(),
                cartRequest.getProductId(),
                cartRequest.getQuantity()
        );

        sendSuccess(
                response,
                "Product added to cart",
                cartService.getCart(buyer.getId())
        );
    }

    private void updateItem(HttpServletRequest request,
                            HttpServletResponse response,
                            User buyer)
            throws IOException {

        CartRequest cartRequest = readRequest(request);

        cartService.updateQuantity(
                buyer.getId(),
                cartRequest.getProductId(),
                cartRequest.getQuantity()
        );

        sendSuccess(
                response,
                "Cart updated successfully",
                cartService.getCart(buyer.getId())
        );
    }

    private void removeItem(HttpServletRequest request,
                            HttpServletResponse response,
                            User buyer)
            throws IOException {

        CartRequest cartRequest = readRequest(request);

        cartService.removeFromCart(
                buyer.getId(),
                cartRequest.getProductId()
        );

        sendSuccess(
                response,
                "Product removed from cart",
                cartService.getCart(buyer.getId())
        );
    }

    private CartRequest readRequest(HttpServletRequest request)
            throws IOException {

        StringBuilder body = new StringBuilder();

        try (BufferedReader reader = request.getReader()) {
            String line;

            while ((line = reader.readLine()) != null) {
                body.append(line);
            }
        }

        return gson.fromJson(body.toString(), CartRequest.class);
    }

    private User getBuyer(HttpServletRequest request) {

        HttpSession session = request.getSession(false);

        if (session == null) {
            return null;
        }

        Object user = session.getAttribute("user");

        if (!(user instanceof User)) {
            return null;
        }

        User buyer = (User) user;

        if (!"BUYER".equalsIgnoreCase(buyer.getRole())) {
            return null;
        }

        return buyer;
    }

    private void sendSuccess(HttpServletResponse response,
                             String message,
                             Object data)
            throws IOException {

        response.getWriter().write(
                gson.toJson(
                        ApiResponse.success(message, data)
                )
        );
    }

    private void sendError(HttpServletResponse response,
                           int status,
                           String message)
            throws IOException {

        response.setStatus(status);

        response.getWriter().write(
                gson.toJson(
                        ApiResponse.error(message)
                )
        );
    }

    private String getMessage(Exception e) {

        if (e.getMessage() == null ||
                e.getMessage().trim().isEmpty()) {
            return "Cart operation failed";
        }

        return e.getMessage();
    }
}
